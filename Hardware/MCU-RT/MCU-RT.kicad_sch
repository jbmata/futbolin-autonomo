	)
	(text "8: TX Pi -> RX MCU / PE0\n10: RX Pi <- TX MCU / PE1 (UART8).\n19: MOSI -> PE14 / SPI4_MOSI\n21: MISO <- PE13 / SPI4_MISO\n23: SCLK -> PE12 / SPI4_SCK\n24: CE0 -> PE11 / SPI4_NSS\nPi: SPI0 master. MCU: SPI4 slave, AF5.\nNSS hardware; MISO Hi-Z si NSS=1.\nGPIO 3V3. GND comun.\n2/4: 5V desde ATX_5V (no 5VSB).\n1/17: 3V3 de la Pi, sin conectar.\nPi solo con ATX; USB no alimenta Pi.\nNo alimentar la Pi por USB a la vez.\nResto GPIO NC. Cable 1:1; ver pin 1."
		(exclude_from_sim no)
		(at 773.43 406.4 0)
		(effects
			(font
				(size 0.85 0.85)
			)
			(justify left top)
		)
		(uuid "776af2dc-98f4-400c-aa8b-eae29ad238fb")
	)
