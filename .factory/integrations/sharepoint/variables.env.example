# SharePoint (Microsoft Graph, app-only) — variable NAMES only. Copy to secrets.env (git-ignored).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=https://<tenant>.sharepoint.com/sites/<site>
# Optional: a specific document-library drive id (else the site's default drive is used)
SHAREPOINT_DRIVE_ID=
